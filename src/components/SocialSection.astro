---
import SocialFeed from './SocialFeed'
import SocialStats from './SocialStats'
---

<section class="bg-white px-6 py-20" id="redes">
  <div class="mx-auto max-w-6xl">
    <!-- Header -->
    <div class="mb-12 text-center">
      <p class="mb-2 text-xs font-semibold tracking-widest text-brownie-700/50 uppercase">
        Comunidad
      </p>
      <h2 class="font-display text-4xl font-bold text-brownie-900 sm:text-5xl">
        Síguenos en redes.
      </h2>
      <p class="mt-3 text-brownie-700/60">
        Cada día compartimos nuevas creaciones, sorpresas y mucho chocolate.
      </p>
    </div>

    <!-- Stats cards -->
    <SocialStats client:load />

    <!-- Feed grid -->
    <div class="mt-12">
      <p class="mb-6 text-sm font-semibold text-brownie-700/50">Últimas publicaciones</p>
      <SocialFeed client:load />
    </div>
  </div>
</section>
