---
import Layout from '../layouts/Layout.astro'
---

<Layout title="Página no encontrada">
  <main class="flex min-h-screen flex-col items-center justify-center bg-cream px-6 py-20 text-center">

    <!-- Floating brownies illustration -->
    <div class="relative mb-8 select-none">
      <span class="absolute -top-6 -left-8 text-4xl opacity-60 animate-[float_3s_ease-in-out_infinite]">🍫</span>
      <span class="absolute -top-2 -right-10 text-3xl opacity-40 animate-[float_3.5s_ease-in-out_0.5s_infinite]">🧁</span>
      <span class="absolute -bottom-4 -left-6 text-2xl opacity-50 animate-[float_2.8s_ease-in-out_1s_infinite]">🍪</span>
      <span class="absolute -bottom-2 -right-8 text-3xl opacity-40 animate-[float_3.2s_ease-in-out_0.3s_infinite]">🍰</span>

      <!-- 404 big number -->
      <p class="font-display text-[9rem] font-bold leading-none text-brownie-100 sm:text-[12rem]">
        404
      </p>
    </div>

    <!-- Dropped brownie graphic -->
    <div class="mb-6 text-7xl">🍫</div>

    <h1 class="font-display text-3xl font-bold text-brownie-900 sm:text-4xl">
      ¡Se nos cayó el brownie!
    </h1>
    <p class="mt-3 max-w-sm text-brownie-700/70">
      La página que buscas no existe o fue movida. Pero tranquilo — los postres siguen aquí.
    </p>

    <!-- Actions -->
    <div class="mt-10 flex flex-wrap justify-center gap-3">
      <a
        class="rounded-full bg-brownie-700 px-8 py-3 text-sm font-medium text-white transition-all hover:bg-brownie-900 active:scale-95"
        href="/"
      >
        Volver al inicio
      </a>
      <a
        class="rounded-full border border-brownie-700 px-8 py-3 text-sm font-medium text-brownie-700 transition-all hover:bg-brownie-700 hover:text-white active:scale-95"
        href="/productos"
      >
        Ver catálogo
      </a>
    </div>

    <!-- Crumb trail -->
    <p class="mt-16 text-xs text-brownie-700/30">Error 404 — Página no encontrada</p>
  </main>
</Layout>

<style>
  @keyframes float {
    0%, 100% { transform: translateY(0px) rotate(-6deg); }
    50%       { transform: translateY(-12px) rotate(6deg); }
  }
</style>
