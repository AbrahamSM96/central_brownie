---
import Layout from '../layouts/Layout.astro'
---

<Layout title="Algo salió mal">
  <main class="flex min-h-screen flex-col items-center justify-center bg-brownie-900 px-6 py-20 text-center">

    <!-- Floating emojis -->
    <div class="relative mb-8 select-none">
      <span class="absolute -top-6 -left-8 text-4xl opacity-30 animate-[float_3s_ease-in-out_infinite]">🔥</span>
      <span class="absolute -top-2 -right-10 text-3xl opacity-25 animate-[float_3.5s_ease-in-out_0.5s_infinite]">💨</span>
      <span class="absolute -bottom-4 -left-6 text-2xl opacity-30 animate-[float_2.8s_ease-in-out_1s_infinite]">🍫</span>
      <span class="absolute -bottom-2 -right-8 text-3xl opacity-20 animate-[float_3.2s_ease-in-out_0.3s_infinite]">😅</span>

      <!-- 500 big number -->
      <p class="font-display text-[9rem] font-bold leading-none text-brownie-700 sm:text-[12rem]">
        500
      </p>
    </div>

    <!-- Burnt brownie graphic -->
    <div class="mb-6 text-7xl">🔥</div>

    <h1 class="font-display text-3xl font-bold text-white sm:text-4xl">
      ¡El horno explotó!
    </h1>
    <p class="mt-3 max-w-sm text-brownie-100/60">
      Algo falló de nuestro lado. Ya le avisamos al pastelero — regresa en unos minutos.
    </p>

    <!-- Actions -->
    <div class="mt-10 flex flex-wrap justify-center gap-3">
      <a
        class="rounded-full bg-rose-400 px-8 py-3 text-sm font-medium text-brownie-900 transition-all hover:bg-rose-100 active:scale-95"
        href="/"
      >
        Volver al inicio
      </a>
      <button
        class="rounded-full border border-brownie-700 px-8 py-3 text-sm font-medium text-brownie-100/70 transition-all hover:border-rose-400 hover:text-rose-400 active:scale-95"
        onclick="window.location.reload()"
      >
        Intentar de nuevo
      </button>
    </div>

    <!-- Crumb trail -->
    <p class="mt-16 text-xs text-brownie-700/50">Error 500 — Error interno del servidor</p>
  </main>
</Layout>

<style>
  @keyframes float {
    0%, 100% { transform: translateY(0px) rotate(-6deg); }
    50%       { transform: translateY(-12px) rotate(6deg); }
  }
</style>
