---
import Layout from '../layouts/Layout.astro'
---

<Layout
  description="Descarga o consulta el menú completo de Central Brownie: brownies, cheesecakes, cupcakes, pasteles y galletas artesanales."
  image="/central_brownie_logo.jpg"
  title="Menú"
>
  <main class="flex min-h-screen flex-col bg-brownie-900">

    <!-- Header -->
    <div class="flex items-center justify-between px-6 py-4">
      <a class="flex items-center gap-2 no-underline" href="/">
        <img alt="Central Brownie" class="h-9 w-9 rounded-full object-cover" src="/centralB_logo.png" />
        <span class="font-display text-lg font-bold text-white">Central Brownie</span>
      </a>
      <a
        class="rounded-full bg-rose-400 px-5 py-2 text-sm font-medium text-brownie-900 transition-all hover:bg-rose-100"
        download
        href="/menu.pdf"
      >
        Descargar PDF
      </a>
    </div>

    <!-- Desktop: iframe viewer -->
    <div class="hidden flex-1 px-4 pb-6 md:flex">
      <iframe
        class="h-[calc(100vh-80px)] w-full rounded-xl border-0"
        src="/menu.pdf"
        title="Menú Central Brownie"
      ></iframe>
    </div>

    <!-- Mobile: download card -->
    <div class="flex flex-1 flex-col items-center justify-center gap-8 px-6 pb-12 md:hidden">
      <div class="text-8xl">🍫</div>

      <div class="text-center">
        <h1 class="font-display text-3xl font-bold text-white">Menú Central Brownie</h1>
        <p class="mt-3 text-brownie-100/60">
          Descarga el menú completo para verlo en tu dispositivo.
        </p>
      </div>

      <div class="flex flex-col items-center gap-3 w-full max-w-xs">
        <a
          class="w-full rounded-full bg-rose-400 px-8 py-4 text-center text-sm font-medium text-brownie-900 transition-all hover:bg-rose-100 active:scale-95"
          download
          href="/menu.pdf"
        >
          Descargar menú (PDF)
        </a>
        <a
          class="w-full rounded-full border border-brownie-700 px-8 py-4 text-center text-sm font-medium text-brownie-100/70 transition-all hover:border-rose-400 hover:text-rose-400 active:scale-95"
          href="/productos"
        >
          Ver catálogo en línea
        </a>
      </div>
    </div>

  </main>
</Layout>
